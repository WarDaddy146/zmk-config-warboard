#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    // Staging keymap: one binding per matrix position (20 total). All are
    // placeholders (&none) until behaviors are wired in later phases. The
    // dead cell RC(2,4) at position 14 is permanently &none.
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &none &none &none &none &none
                &none &none &none &none &none
                &none &none &none &none &none
                &none &none &none &none &none
            >;
        };
    };
};

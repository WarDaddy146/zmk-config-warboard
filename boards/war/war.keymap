// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    // Staging keymap: one binding per matrix position (12 total, 3x4).
    // All are placeholders (&none) until behaviors are wired in later
    // phases. Row_3 and Col_4 excluded from this bring-up pass.
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q &kp W &kp E &kp R
                &kp A &kp S &kp D &kp F
                &kp SHIFT &kp Z &kp X &kp C
            >;
        };
    };
};
